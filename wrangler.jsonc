{
  "name": "student-invoice-printer",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "PASSKEY": "password123"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "invoice_db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
